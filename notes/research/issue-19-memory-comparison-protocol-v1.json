{
  "schema_version": 1,
  "experiment": "M1",
  "effect_policy": {
    "board": false,
    "containers": false,
    "instances": false,
    "model_inference": false,
    "network": false,
    "submissions": false,
    "targets": false
  },
  "arms": [
    {
      "id": "lane_local_v1",
      "same_lane_analysis_claims": true,
      "same_lane_host_observations": true,
      "other_lane_host_observations": false,
      "other_lane_controller_records": false
    },
    {
      "id": "typed_challenge_v1",
      "same_lane_analysis_claims": true,
      "same_lane_host_observations": true,
      "other_lane_host_observations": true,
      "other_lane_controller_records": true
    }
  ],
  "projection": {
    "run_scope": "exact",
    "challenge_scope": "exact",
    "episode_rule": "source_episode < target_episode",
    "verifier_prompt_record_count": 0,
    "cross_lane_allowed_kinds": [
      "host_observation",
      "tactic_outcome",
      "failure"
    ],
    "same_lane_allowed_kinds": [
      "analysis_claim",
      "host_observation",
      "tactic_outcome",
      "failure"
    ],
    "controller_private_kinds": [
      "candidate_context",
      "verification"
    ],
    "kind_order": [
      "host_observation",
      "tactic_outcome",
      "failure",
      "analysis_claim"
    ],
    "ordering": [
      "source_episode_desc",
      "source_lane_asc",
      "source_attempt_id_asc",
      "kind_order_asc",
      "record_id_asc"
    ],
    "deduplication": "before byte selection retain only the first canonical record for each exact repeated_fingerprint; records without a fingerprint remain distinct",
    "selection": "after deduplication iterate canonical order and retain a record only when canonical compact JSON for the whole public projection remains <= projection_bytes; do not backfill a rejected record",
    "projection_bytes": 65536,
    "prompt_bytes": 131072,
    "byte_accounting": "UTF-8 length of JSON encoded with ensure_ascii=true, sort_keys=true, separators=[comma,colon]",
    "cross_lane_analysis_prose_allowed": false,
    "candidate_context_in_prompt": false,
    "verification_in_prompt": false
  },
  "public_record_fields": {
    "analysis_claim": [
      "kind",
      "record_id",
      "source_episode",
      "source_lane",
      "status",
      "summary",
      "evidence",
      "next_steps",
      "tool_count"
    ],
    "host_observation": [
      "kind",
      "record_id",
      "source_episode",
      "source_lane",
      "complete",
      "gap",
      "tool",
      "success",
      "source_bound",
      "facts"
    ],
    "tactic_outcome": [
      "kind",
      "record_id",
      "source_episode",
      "source_lane",
      "role",
      "tactic",
      "tool_profile",
      "status"
    ],
    "failure": [
      "record_id",
      "source_episode",
      "source_lane",
      "kind",
      "failure_kind",
      "subreason"
    ]
  },
  "privacy": {
    "forbidden_field_fragments": [
      "authority",
      "candidate",
      "credential",
      "digest",
      "endpoint",
      "key",
      "password",
      "path",
      "receipt",
      "secret",
      "token"
    ],
    "forbidden_value_forms": [
      "raw candidate",
      "sha256(candidate)",
      "hex(candidate)",
      "base64(candidate)",
      "base64url(candidate)",
      "urlencode(candidate)",
      "absolute path",
      "URL authority",
      "credential canary"
    ],
    "field_matching": "within every projected memory record recursively visit every mapping key and sequence element; NFKC-normalize and Unicode-casefold keys; reject a key when any forbidden_field_fragment is a substring",
    "value_matching": "within every projected memory record recursively visit every string/bytes scalar; reject an exact canary or listed encoding after NFKC normalization, any 64-character lowercase hexadecimal value, any absolute POSIX path, or any URL with a nonempty authority; top-level source/protocol/projection commitments are allowed only when independently recomputed and not candidate-derived",
    "sanitization": "remove every rejected mapping entry and sequence element recursively; replace a rejected required analysis summary with the empty string; retain an otherwise empty record only with its nonprivate required metadata",
    "candidate_sensitive_host_observation_policy": "retain record metadata and safe non-candidate facts only; remove every digest and candidate-derived field",
    "private_context_public_fields": [
      "complete_context_count",
      "invalid_context_count",
      "rejected_context_count",
      "pending_count",
      "verified_count"
    ]
  },
