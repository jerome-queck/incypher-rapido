  "title": "Sanitized Rapido capability run receipt v2",
  "type": "object",
  "$defs": {
    "nullableNonnegativeInt": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "terminalLabel": {
      "enum": [
        "correct",
        "incorrect",
        "already_terminal",
        "unstarted_at_cap",
        "queued_at_cap",
        "attempt_timeout",
        "global_cap",
        "no_unique_candidate",
        "repeated_candidate_only",
        "no_new_durable_observation",
        "tool_absent",
        "dependency_absent",
        "unsupported_format",
        "parser_failure",
        "tool_argument_schema",
        "tool_runtime",
        "sandbox_failure",
        "policy_refusal",
        "context_loss",
        "method_replay_failure",
        "oracle_inconclusive",
        "provider_unavailable",
        "provider_failure",
        "descriptor_mismatch",
        "usage_cap",
        "service_start_failure",
        "service_unready",
        "service_lost",
        "cleanup_failure",
        "privacy_boundary",
        "source_drift",
        "fixture_invalid"
      ]
    },
    "resources": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "cpu_peak_cores": {
                    "type": "null"
                  }
                },
                "required": [
                  "cpu_peak_cores"
                ]
              },
              {
                "properties": {
                  "memory_peak_bytes": {
                    "type": "null"
                  }
                },
                "required": [
                  "memory_peak_bytes"
                ]
              },
              {
                "properties": {
                  "pids_peak": {
                    "type": "null"
                  }
                },
                "required": [
                  "pids_peak"
                ]
              },
              {
                "properties": {
                  "disk_peak_bytes": {
                    "type": "null"
                  }
                },
                "required": [
                  "disk_peak_bytes"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "unavailable_reason": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "unavailable_reason": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "cpu_peak_cores": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "disk_peak_bytes": {
          "$ref": "#/$defs/nullableNonnegativeInt"
        },
        "memory_peak_bytes": {
          "$ref": "#/$defs/nullableNonnegativeInt"
        },
        "pids_peak": {
          "$ref": "#/$defs/nullableNonnegativeInt"
        },
        "unavailable_reason": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "cpu_peak_cores",
        "memory_peak_bytes",
        "pids_peak",
        "disk_peak_bytes",
        "unavailable_reason"
      ],
      "type": "object"
    },
    "task": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "started": {
                "const": true
              }
            },
            "required": [
              "started"
            ]
          },
          "then": {
            "properties": {
              "admitted_ms": {
                "minimum": 0,
                "type": "integer"
              },
              "started_ms": {
                "minimum": 0,
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "raw_correct": {
                "const": true
              }
            },
            "required": [
              "raw_correct"
            ]
          },
          "then": {
            "properties": {
              "first_correct_ms": {
                "minimum": 0,
                "type": "integer"
              },
              "terminal_label": {
                "const": "correct"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "terminal_label": {
