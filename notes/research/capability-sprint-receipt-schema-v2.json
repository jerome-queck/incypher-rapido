{
  "$id": "rapido-capability-public-receipt-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Pre-outcome v2 supersedes v1. Consumers must also run rapido.offline_capability_schema.validate_receipt for cross-field and privacy invariants.",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "cleanup": {
            "properties": {
              "passed": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "cleanup": {
            "properties": {
              "failure_label": {
                "type": "null"
              },
              "owned_containers_remaining": {
                "const": 0
              },
              "owned_networks_remaining": {
                "const": 0
              },
              "owned_processes_remaining": {
                "const": 0
              },
              "owned_run_ids_remaining": {
                "const": 0
              },
              "owned_services_remaining": {
                "const": 0
              },
              "owned_state_objects_remaining": {
                "const": 0
              },
              "owned_volumes_remaining": {
                "const": 0
              },
              "owned_workspaces_remaining": {
                "const": 0
              },
              "inventory_complete": {
                "const": true
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "cleanup": {
            "properties": {
              "failure_label": {
                "const": "cleanup_failure"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cleanup": {
            "properties": {
              "inventory_complete": {
                "const": true
              }
            },
            "required": [
              "inventory_complete"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "cleanup": {
            "properties": {
              "owned_processes_remaining": {
                "minimum": 0,
                "type": "integer"
              },
              "owned_containers_remaining": {
                "minimum": 0,
                "type": "integer"
              },
              "owned_volumes_remaining": {
                "minimum": 0,
                "type": "integer"
              },
              "owned_networks_remaining": {
                "minimum": 0,
                "type": "integer"
              },
              "owned_services_remaining": {
                "minimum": 0,
                "type": "integer"
              },
              "owned_workspaces_remaining": {
                "minimum": 0,
                "type": "integer"
              },
              "owned_state_objects_remaining": {
                "minimum": 0,
                "type": "integer"
              },
              "owned_run_ids_remaining": {
                "minimum": 0,
                "type": "integer"
              }
            }
          }
